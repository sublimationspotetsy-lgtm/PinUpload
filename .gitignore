# Secrets — never commit real keys
.env
.env.local

# Virtualenv + bytecode
.venv/
__pycache__/
*.pyc

# macOS noise
.DS_Store

# Scratch/audit scripts (transient)
_*.py

# Agent tooling (not part of the project)
.agents/
.claude/

# Per-slug Codex artifacts (regenerable, not stored in repo).
# Flat images/<filename>.png ARE tracked: config.yaml image_base_url serves them
# via raw.githubusercontent.com, which Tab 3's CSV Media URL column requires.
images/*/